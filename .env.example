# Copia este archivo a .env y completa los valores. No subas .env al repositorio.

# API
API_HOST=127.0.0.1
API_PORT=8000
# Genera una clave con: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
# Orígenes permitidos para CORS, como lista JSON. Vacío = CORS desactivado.
CORS_ORIGINS=[]

# Base de datos local (SQLite). La ruta es relativa a /app dentro del contenedor.
DATABASE_URL=sqlite:///./data/assistant.db

# Historial enviado al modelo
CHAT_HISTORY_MESSAGES=12
CHAT_MAX_CONTEXT_CHARS=6000

# Investigación web (/research y use_web en /chat)
RESEARCH_MAX_SOURCES=4
# Texto máximo guardado por página (memoria). La verificación recorre todo este texto por fragmentos.
RESEARCH_PAGE_MAX_CHARS=20000
# Texto por fuente que se envía al modelo: solo los fragmentos más relevantes para la pregunta
RESEARCH_CONTEXT_MAX_CHARS=6000
RESEARCH_FETCH_CONCURRENCY=3
RESEARCH_FETCH_TIMEOUT_SECONDS=10
RESEARCH_MAX_PAGE_BYTES=2000000
# Máximo de fuentes que se descargan por búsqueda
RESEARCH_MAX_SOURCES=4
# Consultas: la pregunta original más alternativas por plantilla (total máximo)
RESEARCH_MAX_QUERIES=4

# Fragmentación de la evidencia (sin modelos)
EVIDENCE_FRAGMENT_CHARS=800
EVIDENCE_FRAGMENT_OVERLAP_CHARS=120
EVIDENCE_MAX_FRAGMENTS_PER_SOURCE=40
# Fragmentos candidatos por afirmación
EVIDENCE_MAX_FRAGMENTS_PER_CLAIM=3

# Verificación determinística (sin usar modelos para decidir)
VERIFICATION_SUPPORT_THRESHOLD=0.6
VERIFICATION_CONTRADICTION_THRESHOLD=0.6
VERIFICATION_MIN_INDEPENDENT_SOURCES=1
VERIFICATION_DETECT_CONTRADICTIONS=true
# Tiempo máximo de contraste por respuesta; lo que no se llega a verificar queda sin respaldo
VERIFICATION_MAX_SECONDS=20
# Verificaciones simultáneas en el proceso (CPU)
VERIFICATION_MAX_CONCURRENT=2

# Ollama existente
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:2b-q4_K_M
OLLAMA_TIMEOUT_SECONDS=120
# Llamadas simultáneas al modelo y espera máxima por una plaza (después, 503 "modelo ocupado").
OLLAMA_MAX_CONCURRENT=2
OLLAMA_QUEUE_TIMEOUT_SECONDS=60

# Días que se conservan los registros de consumo por usuario (0 = no borrar)
USAGE_RETENTION_DAYS=90

# SearXNG existente (requiere format=json habilitado en settings.yml)
SEARXNG_BASE_URL=http://127.0.0.1:7080
SEARXNG_TIMEOUT_SECONDS=20

# Redis existente
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SSL=false
REDIS_KEY_PREFIX=local-ai-assistant:

# Módulo de música (yt-dlp + FFmpeg). Suena en este servidor, por el jack auxiliar o por un parlante
# Bluetooth emparejado en el host. false = rutas /music responden 404.
MUSIC_ENABLED=false
# Usuarios (X-User-Ref) que pueden controlar la música, como lista JSON. [] = los que envíe el servidor.
MUSIC_CONTROL_USER_REFS=[]
# Salida al arrancar: aux (cable / jack) o bluetooth. Se cambia luego hablando con Lumi.
MUSIC_OUTPUT_DEFAULT=aux
# Nombre exacto de cada salida (pactl list short sinks). Vacío = se elige sola.
MUSIC_AUX_SINK=
MUSIC_BLUETOOTH_SINK=
# Ganancia fija de FFmpeg en % (0-150) sobre el volumen del sistema (margen para no saturar).
MUSIC_VOLUME_PERCENT=80
# Volumen inicial del reproductor (0-100). Se cambia en caliente con pactl, sin cortar el audio.
MUSIC_VOLUME_DEFAULT=70
# yt-dlp descarga el audio y se lo pasa a FFmpeg por una tubería (YouTube responde 403 si FFmpeg
# abre la URL directamente).
MUSIC_YTDLP_PATH=yt-dlp
# Segundos que una orden espera a que el audio suene antes de responder «cargando».
MUSIC_START_WAIT_SECONDS=15
# Reintentos si la descarga se corta a mitad de canción (sigue desde donde iba).
MUSIC_STREAM_RETRIES=2
# Reproducción automática al acabar la cola (canciones relacionadas reales, Mix de YouTube).
MUSIC_AUTOPLAY_DEFAULT=false
# Máximo de canciones seguidas que añade sin una orden del usuario (evita colas infinitas).
MUSIC_AUTOPLAY_MAX_TRACKS=25
# Canciones recientes que no se vuelven a recomendar ni a reproducir automáticamente.
MUSIC_HISTORY_SIZE=50
# Segundos que se reutilizan las recomendaciones de una canción.
MUSIC_RECOMMENDATIONS_CACHE_SECONDS=600
MUSIC_SAMPLE_RATE=44100
MUSIC_SEARCH_LIMIT=5
MUSIC_SEARCH_TIMEOUT_SECONDS=20
MUSIC_EXTRACT_TIMEOUT_SECONDS=30
# Duración máxima de una pista (segundos) y tamaño de la cola
MUSIC_MAX_TRACK_SECONDS=900
MUSIC_QUEUE_MAX_ITEMS=50
# Para que el contenedor pueda usar los altavoces del host: descomenta. COMPOSE_FILE hace que el comando
# de siempre (docker compose up -d --build) cargue también docker-compose.music.yml.
# COMPOSE_FILE=docker-compose.yml:docker-compose.music.yml
# Socket del servidor de sonido del host (cambia 1000 si tu usuario tiene otro UID: comando `id -u`)
# MUSIC_PULSE_SOCKET=/run/user/1000/pulse/native
