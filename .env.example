# Copia este archivo a .env y completa los valores. No subas .env al repositorio.

# API
API_HOST=127.0.0.1
API_PORT=8000
# Genera una clave con: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
# Orígenes permitidos para CORS, como lista JSON. Vacío = CORS desactivado.
CORS_ORIGINS=[]

# Ollama existente
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b-instruct-q4_K_M
OLLAMA_TIMEOUT_SECONDS=120

# SearXNG existente (requiere format=json habilitado en settings.yml)
SEARXNG_BASE_URL=http://127.0.0.1:7080
SEARXNG_TIMEOUT_SECONDS=20

# Redis existente
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SSL=false
REDIS_KEY_PREFIX=local-ai-assistant:
