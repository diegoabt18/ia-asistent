# Copia este archivo a .env y completa los valores. No subas .env al repositorio.

# API
API_HOST=127.0.0.1
API_PORT=8000
# Genera una clave con: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
# Orígenes permitidos para CORS, como lista JSON. Vacío = CORS desactivado.
CORS_ORIGINS=[]

# Base de datos local (SQLite). La ruta es relativa a /app dentro del contenedor.
DATABASE_URL=sqlite:///./data/assistant.db

# Historial enviado al modelo
CHAT_HISTORY_MESSAGES=12
CHAT_MAX_CONTEXT_CHARS=6000

# Investigación web (/research y use_web en /chat)
RESEARCH_MAX_SOURCES=4
# Texto máximo guardado por página (memoria). La verificación recorre todo este texto por fragmentos.
RESEARCH_PAGE_MAX_CHARS=20000
# Texto por fuente que se envía al modelo: solo los fragmentos más relevantes para la pregunta
RESEARCH_CONTEXT_MAX_CHARS=6000
RESEARCH_FETCH_CONCURRENCY=3
RESEARCH_FETCH_TIMEOUT_SECONDS=10
RESEARCH_MAX_PAGE_BYTES=2000000
# Máximo de fuentes que se descargan por búsqueda
RESEARCH_MAX_SOURCES=4
# Consultas: la pregunta original más alternativas por plantilla (total máximo)
RESEARCH_MAX_QUERIES=4

# Fragmentación de la evidencia (sin modelos)
EVIDENCE_FRAGMENT_CHARS=800
EVIDENCE_FRAGMENT_OVERLAP_CHARS=120
EVIDENCE_MAX_FRAGMENTS_PER_SOURCE=40
# Fragmentos candidatos por afirmación
EVIDENCE_MAX_FRAGMENTS_PER_CLAIM=3

# Verificación determinística (sin usar modelos para decidir)
VERIFICATION_SUPPORT_THRESHOLD=0.6
VERIFICATION_CONTRADICTION_THRESHOLD=0.6
VERIFICATION_MIN_INDEPENDENT_SOURCES=1
VERIFICATION_DETECT_CONTRADICTIONS=true
# Tiempo máximo de contraste por respuesta; lo que no se llega a verificar queda sin respaldo
VERIFICATION_MAX_SECONDS=20
# Verificaciones simultáneas en el proceso (CPU)
VERIFICATION_MAX_CONCURRENT=2

# Ollama existente
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b-instruct-q4_K_M
OLLAMA_TIMEOUT_SECONDS=120

# Días que se conservan los registros de consumo por usuario (0 = no borrar)
USAGE_RETENTION_DAYS=90

# SearXNG existente (requiere format=json habilitado en settings.yml)
SEARXNG_BASE_URL=http://127.0.0.1:7080
SEARXNG_TIMEOUT_SECONDS=20

# Redis existente
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SSL=false
REDIS_KEY_PREFIX=local-ai-assistant:
